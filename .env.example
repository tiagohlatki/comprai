# ================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env — ele está no .gitignore.
# ================================================================

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # Apenas backoffice e funções backend

# ── Backoffice (Next.js) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ── Google Maps ───────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=<google-maps-api-key>

# ── Claude API (normalização de produtos) ────────────────────────
ANTHROPIC_API_KEY=<anthropic-api-key>

# ── Railway / Render (funções backend) ───────────────────────────
RAILWAY_TOKEN=<railway-token>

# ── Flutter (app mobile) — valores injetados via --dart-define ───
# FLUTTER_SUPABASE_URL → SUPABASE_URL
# FLUTTER_SUPABASE_ANON_KEY → SUPABASE_ANON_KEY
# FLUTTER_GOOGLE_MAPS_KEY → GOOGLE_MAPS_API_KEY
